# Copy this to .env and fill in the values.
# NEVER commit .env to version control.

# Postgres
POSTGRES_DB=ledgerly
POSTGRES_USER=ledgerly
# POSTGRES_PASSWORD is read from secrets/db_password.txt (Docker secrets)

# App environment
ENVIRONMENT=production   # development | production

# Price provider (Phase 3) — off by default
# PRICE_PROVIDER_URL=
# PRICE_PROVIDER_API_KEY_FILE=/run/secrets/price_api_key

# Optional Redis (Phase 3 performance hardening)
# REDIS_URL=redis://redis:6379/0
